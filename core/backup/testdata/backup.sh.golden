#!/usr/bin/env bash
# Generated by can (epic E08). Do not edit; regenerate with: can backup install
#
# Runs restic over the dumps can-core produced. Exit codes:
#   0 ok  10 marker missing  11 marker stale  12 another run holds the lock
#   20 restic backup failed  21 forget/prune failed  22 erasure ledger upload failed
# Failures are written to the journal (tag can-backup) and, if /etc/can/backup.d/webhook.url exists, POSTed there.
set -Eeuo pipefail
umask 077

DUMPS='/var/lib/can/dumps'
STATE='/var/lib/can'
K3S='/var/lib/rancher/k3s'
MAX_AGE=86400
RUN_ID=""

log() { logger -t can-backup -p user.info -- "$*" || true; echo "can-backup: $*"; }

notify() {
  [ -s '/etc/can/backup.d/webhook.url' ] || return 0
  local msg=${1//\"/\'}
  curl -fsS -m 10 -X POST -H 'Content-Type: application/json' \
    --data "{\"text\":\"can-backup failed: ${msg}\"}" "$(cat '/etc/can/backup.d/webhook.url')" >/dev/null 2>&1 || true
}

fail() {
  local code=$1; shift
  logger -t can-backup -p user.err -- "FAILED($code): $*" || true
  echo "can-backup: FAILED($code): $*" >&2
  notify "($code) $*"
  trap - ERR
  exit "$code"
}
trap 'fail 1 "unexpected error near line $LINENO"' ERR

# Lock: one run at a time.
exec 9>"$STATE/backup.lock"
flock -n 9 || fail 12 "another backup run holds the lock"

# Credentials come from root-only files, never from the unit or the command line.
ENVFILE='/etc/can/backup.d/restic.env'
[ -r "$ENVFILE" ] || fail 1 "missing $ENVFILE"
set -a
# shellcheck disable=SC1090
. "$ENVFILE"
set +a
export RESTIC_REPOSITORY='s3:https://s3.example.invalid/company-backups/restic'
export RESTIC_PASSWORD_FILE='/etc/can/backup.d/restic.password'
[ -r "$RESTIC_PASSWORD_FILE" ] || fail 1 "missing $RESTIC_PASSWORD_FILE"

# Completion marker: can-core deletes it at the start of a dump run and writes it at the end.
MARKER="$DUMPS/COMPLETE"
[ -r "$MARKER" ] || fail 10 "completion marker $MARKER is missing: can-core has not finished a dump run"
RUN_ID=$(sed -n 's/^run_id=//p' "$MARKER")
FINISHED=$(sed -n 's/^finished_at=//p' "$MARKER")
case "$FINISHED" in ''|*[!0-9]*) fail 11 "completion marker has no valid finished_at" ;; esac
NOW=$(date +%s)
if [ $((NOW - FINISHED)) -gt "$MAX_AGE" ]; then
  fail 11 "completion marker (run $RUN_ID) is older than $((MAX_AGE / 3600))h"
fi

# Host-level state: consistent copy of the k3s SQLite datastore, node token, secrets-encryption key.
HOSTDIR="$DUMPS/host"
install -d -m 0700 "$HOSTDIR"
if [ -f "$K3S/server/db/state.db" ]; then
  rm -f "$HOSTDIR/k3s-state.db"
  sqlite3 "$K3S/server/db/state.db" ".backup '$HOSTDIR/k3s-state.db'"
fi
for f in server/token server/cred/encryption-config.json; do
  if [ -f "$K3S/$f" ]; then cp -p "$K3S/$f" "$HOSTDIR/$(basename "$f")"; fi
done

# Manifest of every dump file, so 'can backup verify' can compare restored hashes.
(cd "$DUMPS" && find . -type f ! -name 'COMPLETE' ! -name 'MANIFEST.sha256' -print0 | sort -z | xargs -0 -r sha256sum >'MANIFEST.sha256'.tmp && mv 'MANIFEST.sha256'.tmp 'MANIFEST.sha256')

# Remove only stale restic locks (restic refuses to remove a live one).
restic unlock || log "restic unlock failed (continuing)"

log "backup starting (run $RUN_ID)"
restic backup --tag can --tag "run-$RUN_ID" \
  --exclude '/var/lib/rancher/k3s/storage/pvc-*_mod-forms_*/**/*.db' \
  '/var/lib/can/dumps' '/var/lib/rancher/k3s/storage' || fail 20 "restic backup failed"

restic forget --keep-within 35d --prune --tag can || fail 21 "restic forget/prune failed"

# Erasure tombstone ledger: encrypted object outside the snapshot prefix.
ledger_rc=0
if [ -s '/var/lib/can/erasure-ledger.jsonl' ]; then
  '/usr/local/bin/can' backup ledger-sync --ledger '/var/lib/can/erasure-ledger.jsonl' --repo "$RESTIC_REPOSITORY" --password-file "$RESTIC_PASSWORD_FILE" || ledger_rc=$?
fi

printf 'run_id=%s\nfinished_at=%s\n' "$RUN_ID" "$(date +%s)" >"$STATE/backup-status.tmp"
mv "$STATE/backup-status.tmp" "$STATE/backup-status"
[ "$ledger_rc" -eq 0 ] || fail 22 "erasure ledger upload failed (snapshot was taken)"
log "backup complete (run $RUN_ID)"
