{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dodwmd/companyinacan/schemas/company.v1.schema.json",
  "title": "Company description (company.yaml), schema version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "domain", "provider"],
  "properties": {
    "schema": { "const": 1, "description": "Schema version; this file validates version 1." },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "domain": {
      "type": "string",
      "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$",
      "description": "Public DNS name of the company (lowercase)."
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["local", "ssh", "hetzner", "digitalocean", "static"] },
        "options": { "type": "object", "description": "Provider-specific options, validated per provider in later epics." }
      }
    },
    "modules": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]{1,30}$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean" },
          "settings": { "type": "object" }
        }
      }
    },
    "primary": {
      "type": "object",
      "description": "Capability name -> module id designated as the primary provider.",
      "propertyNames": { "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9]+)*$" },
      "additionalProperties": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}$" }
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tagline": { "type": "string", "maxLength": 200 },
        "template": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "brand": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "colours": { "type": "array", "items": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" } },
            "logo": { "type": "string" }
          }
        },
        "description": {
          "type": "string",
          "maxLength": 300,
          "description": "Meta description; defaults to the tagline."
        },
        "lang": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
          "description": "BCP 47 language tag of the page (default en)."
        },
        "og_image": {
          "type": "string",
          "pattern": "^(https://[^\\s]+|/[^\\s]*)$",
          "maxLength": 500,
          "description": "Open Graph image: https URL or site-relative path."
        },
        "noindex": {
          "type": "boolean",
          "description": "Emit noindex and a disallow-all robots.txt (for staging)."
        },
        "same_as": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "pattern": "^https://[^\\s]+$"
          },
          "description": "Profile URLs for the JSON-LD Organization (sameAs)."
        },
        "hero": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "headline"
          ],
          "properties": {
            "headline": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "subheadline": {
              "type": "string",
              "maxLength": 300
            },
            "cta": {
              "$ref": "#/$defs/button"
            },
            "secondary_cta": {
              "$ref": "#/$defs/button"
            }
          }
        },
        "features": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title"
            ],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "description": {
                "type": "string",
                "maxLength": 400
              }
            }
          }
        },
        "pricing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "plans"
          ],
          "properties": {
            "title": {
              "type": "string",
              "maxLength": 80
            },
            "subtitle": {
              "type": "string",
              "maxLength": 300
            },
            "plans": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "price"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  "price": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 30
                  },
                  "period": {
                    "type": "string",
                    "maxLength": 30
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "features": {
                    "type": "array",
                    "maxItems": 12,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    }
                  },
                  "cta": {
                    "$ref": "#/$defs/button"
                  },
                  "highlighted": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "faq": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "question",
              "answer"
            ],
            "properties": {
              "question": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "answer": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            }
          }
        },
        "cta": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "headline",
            "button"
          ],
          "properties": {
            "headline": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "text": {
              "type": "string",
              "maxLength": 300
            },
            "button": {
              "$ref": "#/$defs/button"
            }
          }
        },
        "footer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 200
            },
            "links": {
              "type": "array",
              "maxItems": 12,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "label",
                  "href"
                ],
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  "href": {
                    "$ref": "#/$defs/href"
                  }
                }
              }
            }
          }
        }
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "endpoint": { "type": "string", "pattern": "^https?://" },
        "bucket": { "type": "string", "minLength": 3 },
        "region": { "type": "string" },
        "secret_ref": { "$ref": "#/$defs/secretRef" }
      }
    },
    "email": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "relay": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host"],
          "properties": {
            "host": { "type": "string", "minLength": 1 },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "secret_ref": { "$ref": "#/$defs/secretRef" }
          }
        },
        "inbound": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "mode": { "enum": ["imap", "parse"] } }
        }
      }
    }
  },
  "$defs": {
    "secretRef": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._/-]*$",
      "description": "Name of a secret stored outside this file. Never the secret value itself."
    },
    "href": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(https?://[^\\s]+|mailto:[^\\s]+|/[^\\s]*|#[^\\s]*)$",
      "description": "http(s) URL, mailto: link, site-relative path or fragment."
    },
    "button": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "href"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "href": {
          "$ref": "#/$defs/href"
        }
      }
    }
  }
}
