{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dodwmd/companyinacan/schemas/company.v1.schema.json",
  "title": "Company description (company.yaml), schema version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "domain", "provider"],
  "properties": {
    "schema": { "const": 1, "description": "Schema version; this file validates version 1." },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "domain": {
      "type": "string",
      "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$",
      "description": "Public DNS name of the company (lowercase)."
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["local", "ssh", "hetzner", "digitalocean", "static"] },
        "options": { "type": "object", "description": "Provider-specific options. For digitalocean the keys are checked by `can validate` (unknown keys, port, secret reference); see docs/providers.md." }
      }
    },
    "dns": {
      "type": "object",
      "additionalProperties": false,
      "description": "DNS plugin used by `can up` / `can down` (default: manual, which prints the records). See docs/providers.md.",
      "properties": {
        "provider": { "enum": ["manual", "cloudflare"] },
        "zone": { "type": "string", "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$", "description": "Cloudflare zone name; default: the zone found for the company domain." },
        "ttl": { "type": "integer", "minimum": 1, "maximum": 86400, "description": "Record TTL in seconds; 1 means automatic (Cloudflare). Default 300." },
        "proxied": { "type": "boolean", "description": "Cloudflare proxy (orange cloud). Default false: ACME HTTP-01 must reach the origin." },
        "adopt_existing": { "type": "boolean", "description": "Take over an existing unproxied record of the same name and type. Adopted records are never deleted by `can down`. Default false." },
        "token_secret_ref": { "type": "string", "pattern": "^(env:[A-Z_][A-Z0-9_]*|file:[^\\s]+)$", "description": "Where the Cloudflare API token is read from: env:NAME or file:PATH. Never the token itself. Default env:CLOUDFLARE_API_TOKEN." }
      }
    },
    "modules": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]{1,30}$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean" },
          "settings": { "type": "object" },
          "expose": {
            "type": "object",
            "additionalProperties": false,
            "description": "What of the module is reachable through the ingress (docs/module-routing.md).",
            "properties": {
              "ui": { "type": "boolean", "description": "Route the web UI on https://<module id>.<domain>. Default false." },
              "api": { "type": "boolean", "description": "Route the module API (/v1) on the same host. Default false." },
              "public": { "type": "boolean", "description": "Route the module's anonymous surface (careers pages, /_forms). Default true. finance publishes its invoice links only when this is written as true." },
              "signing": { "type": "boolean", "description": "finance: route the single-use contract signing pages (/public/sign/) on https://finance.<domain>. Default false." },
              "edge_limit": { "type": "boolean", "description": "Rate-limit sign-in and anonymous routes at the ingress, per client address. Default true; set false behind a proxy or CDN." },
              "token_login": { "type": "boolean", "description": "Keep the paste-a-token sign-in on a routed web UI. Default false." }
            }
          }
        }
      }
    },
    "primary": {
      "type": "object",
      "description": "Capability name -> module id designated as the primary provider.",
      "propertyNames": { "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9]+)*$" },
      "additionalProperties": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}$" }
    },
    "approvals": {
      "type": "object",
      "description": "Approval policies by approval type (declared by modules in module.yaml `approvals`). See docs/approvals.md.",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": { "$ref": "#/$defs/approvalPolicy" }
    },
    "sso": {
      "type": "object",
      "description": "OpenID Connect single sign-on for the admin UI (docs/sso.md). The client secret is a Secret name, never a value.",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "issuer": { "type": "string", "maxLength": 500 },
        "client_id": { "type": "string", "maxLength": 256 },
        "client_secret_ref": { "type": "string", "maxLength": 507 },
        "scopes": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 64 } },
        "redirect_base_url": { "type": "string", "maxLength": 300 },
        "claims": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "subject": { "type": "string", "maxLength": 64 },
            "email": { "type": "string", "maxLength": 64 },
            "groups": { "type": "string", "maxLength": 64 },
            "name": { "type": "string", "maxLength": 64 }
          }
        },
        "allowed_email_domains": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 253 } },
        "require_email_verified": { "type": "boolean" },
        "require_amr": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 64 } },
        "group_roles": {
          "type": "object",
          "maxProperties": 200,
          "additionalProperties": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 81 } }
        },
        "confirm_owner_mapping": { "type": "boolean" },
        "require_mapped_role": { "type": "boolean" },
        "local_login": { "enum": ["all", "owner_only", "disabled"] },
        "confirm_disable_local_login": { "type": "boolean" },
        "revalidate_interval": { "type": "string", "maxLength": 16 },
        "rp_logout": { "type": "boolean" },
        "allow_any_account": { "type": "boolean" },
        "allow_insecure_dev": { "type": "boolean" }
      }
    },
    "notifications": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "webhooks": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9-]{0,30}$" },
          "additionalProperties": { "type": "string", "pattern": "^https://[^\\s/?#][^\\s]*$", "maxLength": 500 }
        }
      }
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tagline": { "type": "string", "maxLength": 200 },
        "template": { "enum": ["classic"], "description": "Built-in template; classic is the only one." },
        "brand": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "colours": { "type": "array", "items": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" } },
            "logo": { "type": "string" }
          }
        },
        "description": {
          "type": "string",
          "maxLength": 300,
          "description": "Meta description; defaults to the tagline."
        },
        "lang": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
          "description": "BCP 47 language tag of the page (default en)."
        },
        "og_image": {
          "type": "string",
          "pattern": "^(https://[^\\s/?#][^\\s]*|/|/[^\\s/\\\\][^\\s]*)$",
          "maxLength": 500,
          "description": "Open Graph image: https URL or site-relative path."
        },
        "noindex": {
          "type": "boolean",
          "description": "Emit noindex and a disallow-all robots.txt (for staging)."
        },
        "same_as": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "pattern": "^https://[^\\s/?#][^\\s]*$"
          },
          "description": "Profile URLs for the JSON-LD Organization (sameAs)."
        },
        "hero": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "headline"
          ],
          "properties": {
            "headline": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "subheadline": {
              "type": "string",
              "maxLength": 300
            },
            "cta": {
              "$ref": "#/$defs/button"
            },
            "secondary_cta": {
              "$ref": "#/$defs/button"
            }
          }
        },
        "features": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title"
            ],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "description": {
                "type": "string",
                "maxLength": 400
              }
            }
          }
        },
        "pricing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "plans"
          ],
          "properties": {
            "title": {
              "type": "string",
              "maxLength": 80
            },
            "subtitle": {
              "type": "string",
              "maxLength": 300
            },
            "plans": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "price"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  "price": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 30
                  },
                  "period": {
                    "type": "string",
                    "maxLength": 30
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "features": {
                    "type": "array",
                    "maxItems": 12,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    }
                  },
                  "cta": {
                    "$ref": "#/$defs/button"
                  },
                  "highlighted": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "faq": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "question",
              "answer"
            ],
            "properties": {
              "question": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "answer": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            }
          }
        },
        "cta": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "headline",
            "button"
          ],
          "properties": {
            "headline": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "text": {
              "type": "string",
              "maxLength": 300
            },
            "button": {
              "$ref": "#/$defs/button"
            }
          }
        },
        "contact": {
          "type": "object",
          "additionalProperties": false,
          "description": "Contact section: a button to the form the forms module serves at /_forms/<form>/form on the site's origin (docs/site-contact.md).",
          "properties": {
            "title": { "type": "string", "maxLength": 80, "description": "Default: Contact us." },
            "text": { "type": "string", "maxLength": 300 },
            "form": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,40}$", "description": "Id of a form the forms module serves. Default: contact." },
            "button": { "type": "string", "maxLength": 40, "description": "Default: Send us a message." }
          }
        },
        "footer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 200
            },
            "links": {
              "type": "array",
              "maxItems": 12,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "label",
                  "href"
                ],
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  "href": {
                    "$ref": "#/$defs/href"
                  }
                }
              }
            }
          }
        }
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "endpoint": { "type": "string", "pattern": "^https?://" },
        "bucket": { "type": "string", "minLength": 3 },
        "region": { "type": "string" },
        "secret_ref": { "$ref": "#/$defs/secretRef" }
      }
    },
    "email": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "relay": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host"],
          "properties": {
            "host": { "type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[A-Za-z0-9.:-]+$", "description": "SMTP relay host name or IP address (no scheme, no port)." },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535, "description": "Default 587." },
            "tls": { "enum": ["starttls", "implicit", "none"], "description": "Default implicit for port 465, otherwise starttls. `none` is refused unless can-core runs with CAN_SMTP_ALLOW_INSECURE=true (development)." },
            "from": { "type": "string", "maxLength": 254, "description": "Sender address of all mail; default no-reply@<domain>." },
            "secret_ref": { "$ref": "#/$defs/secretRef", "description": "Reserved. can-core reads the relay credentials only from the Secret can-system/can-smtp-relay (docs/email.md)." }
          }
        },
        "notification_recipients": { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 254 }, "description": "Where notification mail may go: addresses or whole domains (@b.example). Default: the company domain. A person's verified single sign-on address is always accepted." },
        "modules": {
          "type": "object",
          "description": "Per-module sending rules of the email.send capability (docs/email.md).",
          "propertyNames": { "pattern": "^[a-z][a-z0-9-]{1,30}$" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": { "type": "boolean", "description": "false refuses all mail from the module." },
              "recipients": { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 254 }, "description": "Addresses (a@b.example) or whole domains (@b.example) the module may mail. Replaces the default (the company domain and the module's notify_email setting)." },
              "per_hour": { "type": "integer", "minimum": 1, "maximum": 10000 },
              "per_day": { "type": "integer", "minimum": 1, "maximum": 100000 },
              "external_recipients": { "type": "boolean", "description": "finance only: let it mail contract signers at any address, not only those under recipients (docs/email.md). Default false." },
              "notification_text": { "type": "boolean", "description": "Let notification mail caused by this module carry the module's own title and text. Default false: a fixed text with the type and a link to the admin inbox." }
            }
          }
        },
        "inbound": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "mode": { "enum": ["imap", "parse"] } }
        }
      }
    }
  },
  "$defs": {
    "approver": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "role": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(:[a-z][a-z0-9-]*)?$", "description": "A role of the module the request belongs to, or module:role for another module's role; built-in roles (owner, operator, auditor) as they are." },
        "user": { "type": "string", "pattern": "^(user|party):[A-Za-z0-9_.@-]{1,64}$" },
        "manager_of_requester": { "const": true }
      }
    },
    "approvalPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps"],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "approvers"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 40 },
              "approvers": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "$ref": "#/$defs/approver" } },
              "quorum": { "type": "integer", "minimum": 1, "maximum": 10 },
              "parallel": { "type": "boolean" },
              "when": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": { "amount_gte": { "type": "integer", "minimum": 0 }, "amount_lt": { "type": "integer", "minimum": 1 } }
              },
              "fallback": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/approver" } }
            }
          }
        },
        "expires_after": { "type": "string", "pattern": "^[1-9][0-9]*[hd]$" },
        "escalate_after": { "type": "string", "pattern": "^[1-9][0-9]*[hd]$" },
        "escalate_to": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/approver" } }
      }
    },
    "secretRef": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._/-]*$",
      "description": "Name of a secret stored outside this file. Never the secret value itself."
    },
    "href": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(https?://[^\\s/?#][^\\s]*|mailto:[^\\s]+|/|/[^\\s/\\\\][^\\s]*|#[^\\s]*)$",
      "description": "http(s) URL, mailto: link, site-relative path or fragment."
    },
    "button": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "href"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "href": {
          "$ref": "#/$defs/href"
        }
      }
    }
  }
}
