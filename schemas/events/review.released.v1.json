{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dodwmd/companyinacan/schemas/events/review.released.v1.json",
  "title": "review.released.v1",
  "description": "Published when a performance review is released to its subject after approval. Carries opaque ids and a date only: never a rating, summary, calibration note or feedback. `person_id` is the subject. Delivered at least once; consumers de-duplicate on `id`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "time",
    "source",
    "data"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^evt_[0-9a-f]{24}$",
      "description": "Unique event id, stable across redeliveries."
    },
    "type": {
      "const": "review.released.v1"
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "description": "When the event was produced (UTC)."
    },
    "source": {
      "const": "people"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cycle_id",
        "review_id",
        "person_id",
        "released_on"
      ],
      "properties": {
        "cycle_id": {
          "type": "string",
          "pattern": "^cyc_[0-9a-f]{24}$"
        },
        "review_id": {
          "type": "string",
          "pattern": "^rev_[0-9a-f]{24}$"
        },
        "person_id": {
          "type": "string",
          "pattern": "^pers_[0-9a-f]{24}$"
        },
        "released_on": {
          "type": "string",
          "format": "date"
        }
      }
    }
  }
}
