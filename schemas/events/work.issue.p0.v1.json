{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dodwmd/companyinacan/schemas/events/work.issue.p0.v1.json",
  "title": "work.issue.p0.v1",
  "description": "Published when an unresolved issue becomes priority P0 (created or raised), or a P0 issue is assigned to someone else. Imported issues do not raise it. `issue_id` is the issue key. Delivered at least once; consumers de-duplicate on `id`. Carries identifiers, dates and counts only: no names, amounts, reasons or other text (fetch the record through the capability if the token allows).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "time",
    "source",
    "data"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^evt_[0-9a-f]{24}$",
      "description": "Unique event id, stable across redeliveries."
    },
    "type": {
      "const": "work.issue.p0.v1"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "const": "work"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_id",
        "project",
        "assignee"
      ],
      "properties": {
        "issue_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]{1,9}-[1-9][0-9]{0,9}$"
        },
        "project": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]{1,9}$"
        },
        "assignee": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 254
        }
      }
    }
  }
}
