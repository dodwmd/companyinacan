{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dodwmd/companyinacan/schemas/events/work.comment.created.v1.json",
  "title": "work.comment.created.v1",
  "description": "Published when a comment is added to an issue. Carries no comment body: consumers fetch it through the `work` capability if their token allows. Delivered at least once.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "time",
    "source",
    "data"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^evt_[0-9a-f]{24}$",
      "description": "Unique event id, stable across redeliveries."
    },
    "type": {
      "const": "work.comment.created.v1"
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "description": "When the event was produced (UTC)."
    },
    "source": {
      "const": "work"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_key",
        "project",
        "comment_id",
        "author",
        "created_at"
      ],
      "properties": {
        "issue_key": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]{1,9}-[1-9][0-9]{0,9}$"
        },
        "project": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]{1,9}$"
        },
        "comment_id": {
          "type": "integer",
          "minimum": 1
        },
        "author": {
          "type": "string",
          "maxLength": 254
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
