{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dodwmd/companyinacan/schemas/events/oneonone.scheduled.v1.json",
  "title": "oneonone.scheduled.v1",
  "description": "Published when a 1:1 meeting is scheduled in a series. Delivered at least once; consumers de-duplicate on `id`. The payload carries opaque ids and machine values only, never names, contact data or free text (SPEC.md sections 3.7 and 4.3).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "time",
    "source",
    "data"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^evt_[0-9a-f]{24}$",
      "description": "Unique event id, stable across redeliveries."
    },
    "type": {
      "const": "oneonone.scheduled.v1"
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "description": "When the event was produced (UTC)."
    },
    "source": {
      "const": "people"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "meeting_id",
        "series_id",
        "manager_party_id",
        "report_party_id",
        "scheduled_at",
        "cadence"
      ],
      "properties": {
        "meeting_id": {
          "type": "string",
          "pattern": "^mtg_[0-9a-f]{24}$"
        },
        "series_id": {
          "type": "string",
          "pattern": "^ser_[0-9a-f]{24}$"
        },
        "manager_party_id": {
          "type": "string",
          "pattern": "^pers_[0-9a-f]{24}$"
        },
        "report_party_id": {
          "type": "string",
          "pattern": "^pers_[0-9a-f]{24}$"
        },
        "scheduled_at": {
          "type": "string",
          "format": "date-time"
        },
        "cadence": {
          "enum": [
            "weekly",
            "biweekly",
            "monthly"
          ]
        }
      }
    }
  }
}
