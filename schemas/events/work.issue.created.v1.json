{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dodwmd/companyinacan/schemas/events/work.issue.created.v1.json",
  "title": "work.issue.created.v1",
  "description": "Published by the work module when an issue is created (SPEC.md section 3.3, `work`). Delivered at least once; consumers de-duplicate on `id`. Carries no description: consumers fetch the issue through the `work` capability if their token allows.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "time",
    "source",
    "data"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^evt_[0-9a-f]{24}$",
      "description": "Unique event id, stable across redeliveries."
    },
    "type": {
      "const": "work.issue.created.v1"
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "description": "When the event was produced (UTC)."
    },
    "source": {
      "const": "work"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_key",
        "project",
        "type",
        "title",
        "priority",
        "status",
        "reporter",
        "created_at"
      ],
      "properties": {
        "issue_key": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]{1,9}-[1-9][0-9]{0,9}$"
        },
        "project": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]{1,9}$"
        },
        "type": {
          "enum": [
            "epic",
            "story",
            "task",
            "bug",
            "subtask"
          ]
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "priority": {
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ]
        },
        "status": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,29}$"
        },
        "reporter": {
          "type": "string",
          "maxLength": 254
        },
        "assignee": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 254
        },
        "parent": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9]{1,9}-[1-9][0-9]{0,9}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
