{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dodwmd/companyinacan/schemas/events/subscriber.added.v1.json",
  "title": "subscriber.added.v1",
  "description": "Published by the newsletter module's adapter when an address is added to a list, before or after double opt-in confirmation (see `status`). Delivered at least once; consumers de-duplicate on `id`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "time", "source", "data"],
  "properties": {
    "id": { "type": "string", "pattern": "^evt_[0-9a-f]{24}$" },
    "type": { "const": "subscriber.added.v1" },
    "time": { "type": "string", "format": "date-time" },
    "source": { "const": "newsletter" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subscriber_id", "email", "lists", "status", "origin", "added_at"],
      "properties": {
        "subscriber_id": { "type": "string", "pattern": "^sb_[0-9]{1,18}$" },
        "email": { "type": "string", "maxLength": 254 },
        "name": { "type": "string", "maxLength": 200 },
        "lists": { "type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,40}$", "description": "List slug." } },
        "status": { "enum": ["unconfirmed", "confirmed"], "description": "`unconfirmed` while double opt-in is pending; no campaign is sent to it." },
        "origin": { "enum": ["form", "api", "import", "lead"] },
        "lead_id": { "type": "string", "pattern": "^ld_[0-9a-f]{24}$", "description": "Set when origin is `lead` (subscribed from a lead.created.v1 event)." },
        "party_id": { "type": "string", "minLength": 1 },
        "added_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
