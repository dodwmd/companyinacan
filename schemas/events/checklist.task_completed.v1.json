{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dodwmd/companyinacan/schemas/events/checklist.task_completed.v1.json",
  "title": "checklist.task_completed.v1",
  "description": "Published when an onboarding or offboarding checklist task is completed. `action` carries the machine hook of the task (for example identity.provision) so a provisioning integration can react. Delivered at least once; consumers de-duplicate on `id`. The payload carries opaque ids and machine values only, never names, contact data or free text (SPEC.md sections 3.7 and 4.3).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "time",
    "source",
    "data"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^evt_[0-9a-f]{24}$",
      "description": "Unique event id, stable across redeliveries."
    },
    "type": {
      "const": "checklist.task_completed.v1"
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "description": "When the event was produced (UTC)."
    },
    "source": {
      "const": "people"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "checklist_id",
        "party_id",
        "completed_at"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^task_[0-9a-f]{24}$"
        },
        "checklist_id": {
          "type": "string",
          "pattern": "^chk_[0-9a-f]{24}$"
        },
        "party_id": {
          "type": "string",
          "pattern": "^pers_[0-9a-f]{24}$"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "action": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,40}$"
        }
      }
    }
  }
}
