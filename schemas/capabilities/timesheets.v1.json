{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dodwmd/companyinacan/schemas/capabilities/timesheets.v1.json",
  "title": "timesheets.v1",
  "description": "Capability `timesheets` (SPEC.md section 3.3 and 4.3, the `time` row): weekly timesheets per person with project and task references, a submit, approve and reject workflow, locked periods, and a generator that turns approved billable time into a draft invoice. Project and task keys are opaque references to the `work` tracker (`projects.v1` and `work.v1`); this service never calls it. A person's own token (own_only) sees only their sheets; nobody approves their own. Same authentication, scoping, ETag and idempotency conventions as invoices.v1.",
  "x-capability": "timesheets",
  "x-verbs": [
    {
      "verb": "list",
      "method": "GET",
      "path": "/v1/timesheets",
      "response": "TimesheetList",
      "permission": "finance.read",
      "description": "Query: owner, status, from, to (week start), cursor, limit."
    },
    {
      "verb": "get",
      "method": "GET",
      "path": "/v1/timesheets/{id}",
      "response": "Timesheet",
      "permission": "finance.read"
    },
    {
      "verb": "open",
      "method": "POST",
      "path": "/v1/timesheets",
      "request": "OpenTimesheetRequest",
      "response": "Timesheet",
      "write": true,
      "permission": "finance.write",
      "description": "Opens a week (a Monday) or returns the one that exists (200 instead of 201)."
    },
    {
      "verb": "set_entries",
      "method": "PUT",
      "path": "/v1/timesheets/{id}/entries",
      "request": "SetEntriesRequest",
      "response": "Timesheet",
      "write": true,
      "permission": "finance.write",
      "description": "Replaces all entries of a draft or rejected sheet."
    },
    {
      "verb": "submit",
      "method": "POST",
      "path": "/v1/timesheets/{id}/submit",
      "response": "Timesheet",
      "write": true,
      "permission": "finance.write"
    },
    {
      "verb": "approve",
      "method": "POST",
      "path": "/v1/timesheets/{id}/approve",
      "response": "Timesheet",
      "write": true,
      "permission": "finance.approve",
      "description": "403 separation_of_duties for the owner. Emits timesheet.approved.v1."
    },
    {
      "verb": "reject",
      "method": "POST",
      "path": "/v1/timesheets/{id}/reject",
      "request": "RejectRequest",
      "response": "Timesheet",
      "write": true,
      "permission": "finance.approve"
    }
  ],
  "$defs": {
    "EntryInput": {
      "type": "object",
      "required": [
        "day",
        "project",
        "minutes"
      ],
      "properties": {
        "day": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "project": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^[A-Z][A-Z0-9]{1,9}$"
        },
        "task": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^([A-Z][A-Z0-9]{1,9}-[1-9][0-9]{0,9})?$"
        },
        "minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440
        },
        "billable": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "maxLength": 500
        }
      },
      "additionalProperties": false
    },
    "Timesheet": {
      "type": "object",
      "required": [
        "id",
        "owner",
        "week_start",
        "status",
        "entries",
        "total_minutes",
        "billable_minutes",
        "version"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "owner": {
          "type": "string",
          "maxLength": 254
        },
        "week_start": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "status": {
          "enum": [
            "draft",
            "submitted",
            "approved",
            "rejected"
          ]
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "day",
              "project",
              "minutes",
              "billable"
            ],
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 1
              },
              "day": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "project": {
                "type": "string",
                "maxLength": 10
              },
              "task": {
                "type": "string"
              },
              "minutes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1440
              },
              "billable": {
                "type": "boolean"
              },
              "description": {
                "type": "string"
              },
              "invoice_id": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          }
        },
        "total_minutes": {
          "type": "integer",
          "minimum": 0
        },
        "billable_minutes": {
          "type": "integer",
          "minimum": 0
        },
        "reject_reason": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "TimesheetList": {
      "type": "object",
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Timesheet"
          }
        },
        "next_cursor": {
          "type": "string"
        }
      }
    },
    "OpenTimesheetRequest": {
      "type": "object",
      "required": [
        "week_start"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "maxLength": 254
        },
        "week_start": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      },
      "additionalProperties": false
    },
    "SetEntriesRequest": {
      "type": "object",
      "required": [
        "entries"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EntryInput"
          },
          "maxItems": 500
        }
      },
      "additionalProperties": false
    },
    "RejectRequest": {
      "type": "object",
      "required": [
        "reason"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "maxLength": 500,
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
