        "items"
      ]
    },
    "EndMemberRequest": {
      "type": "object",
      "properties": {
        "end_date": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      },
      "additionalProperties": false
    },
    "MeetingInput": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 200,
          "minLength": 1
        },
        "starts_on": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "starts_time": {
          "type": "string",
          "pattern": "^[0-2][0-9]:[0-5][0-9]$"
        },
        "mode": {
          "type": "string",
          "enum": [
            "in-person",
            "remote",
            "hybrid"
          ]
        },
        "notice_given_on": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "short_notice_waiver_ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "invitees": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "person_id": {
                "type": "string",
                "pattern": "^pers_[0-9a-f]{24}$"
              },
              "capacity": {
                "type": "string",
                "enum": [
                  "attendee",
                  "officer"
                ]
              }
            },
            "additionalProperties": false,
            "required": [
              "person_id",
              "capacity"
            ]
          },
          "maxItems": 200
        }
      },
      "additionalProperties": false,
      "required": [
        "title",
        "starts_on"
      ]
    },
    "Meeting": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^mtg_[0-9a-f]{24}$"
        },
        "body_id": {
          "type": "string",
          "pattern": "^bdy_[0-9a-f]{24}$"
        },
        "title": {
          "type": "string"
        },
        "starts_on": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "starts_time": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "enum": [
            "in-person",
            "remote",
            "hybrid"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "scheduled",
            "held",
            "cancelled"
          ]
        },
        "notice_given_on": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "notice_days_required": {
          "type": "integer",
          "minimum": 0,
          "maximum": 366
        },
        "short_notice_waiver_ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "pack_issued_on": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "invitees": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "person_id": {
                "type": "string",
                "pattern": "^pers_[0-9a-f]{24}$"
              },
              "capacity": {
                "type": "string",
