{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dodwmd/companyinacan/schemas/capabilities/analytics.v1.json",
  "title": "analytics.v1",
  "description": "Capability `analytics` (SPEC.md section 4.3): privacy-friendly site statistics (GoatCounter today). Read-only apart from the site registration: the tracker itself posts directly from the visitor's browser to the module's public host, not through this API. No personal data crosses this contract; only aggregates. Authentication: projected ServiceAccount token (audience `can`).",
  "x-capability": "analytics",
  "x-verbs": [
    { "verb": "snippet", "method": "GET", "path": "/v1/snippet", "response": "Snippet", "permission": "analytics.read", "description": "The tracking script tag the site renderer embeds." },
    { "verb": "summary", "method": "GET", "path": "/v1/stats/summary", "response": "Summary", "permission": "analytics.read", "description": "Query: from, to (RFC 3339 dates)." },
    { "verb": "top_paths", "method": "GET", "path": "/v1/stats/paths", "response": "PathStats", "permission": "analytics.read", "description": "Query: from, to, limit (max 100)." },
    { "verb": "register_site", "method": "PUT", "path": "/v1/site", "request": "RegisterSiteRequest", "response": "Snippet", "write": true, "permission": "analytics.admin", "description": "Idempotent: points the tracker at the site's public domain." }
  ],
  "$defs": {
    "Snippet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint", "script_src", "html"],
      "properties": {
        "endpoint": { "type": "string", "pattern": "^https?://", "description": "Collection endpoint, e.g. https://stats.example.com/count." },
        "script_src": { "type": "string", "pattern": "^https?://" },
        "html": { "type": "string", "maxLength": 2000 }
      }
    },
    "Summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "pageviews", "visitors"],
      "properties": {
        "from": { "type": "string", "format": "date" },
        "to": { "type": "string", "format": "date" },
        "pageviews": { "type": "integer", "minimum": 0 },
        "visitors": { "type": "integer", "minimum": 0, "description": "Unique visitors, counted without cookies or stored IP addresses." }
      }
    },
    "PathStats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "paths"],
      "properties": {
        "from": { "type": "string", "format": "date" },
        "to": { "type": "string", "format": "date" },
        "paths": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "pageviews", "visitors"],
            "properties": {
              "path": { "type": "string", "pattern": "^/" },
              "pageviews": { "type": "integer", "minimum": 0 },
              "visitors": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "RegisterSiteRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain"],
      "properties": { "domain": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$", "maxLength": 253 } }
    }
  }
}
