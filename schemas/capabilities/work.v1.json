{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dodwmd/companyinacan/schemas/capabilities/work.v1.json",
  "title": "work.v1",
  "description": "Capability `work` (SPEC.md section 3.3 and 4.3): create, read, update, transition and comment on issues (stories, tasks, bugs, epics, subtasks). Provided natively by the in-house work module (`can-work`) and, later, by an adapter in front of Plane. Consumers must not depend on anything not in this file; the complete REST surface of the in-house module (projects, sprints, boards, links, watchers, tokens) is specs/011-work-tracker/contracts/openapi.yaml. Bodies are JSON over HTTP with a bearer API token (scopes work.read, work.write, work.admin; optionally limited to some projects). Priorities: P0 drop everything, P1 this sprint, P2 planned, P3 backlog. Issues carry a `version` that is also the ETag: send `If-Match: \"<version>\"` on update and transition to detect concurrent edits (412).",
  "x-capability": "work",
  "x-verbs": [
    {
      "verb": "search",
      "method": "GET",
      "path": "/v1/issues",
      "response": "IssueList",
      "permission": "work.read",
      "description": "Query: q (search language, e.g. `status:todo priority:P0,P1 assignee:me label:backend -type:bug is:open`), project, sort, cursor, limit (max 100)."
    },
    {
      "verb": "get",
      "method": "GET",
      "path": "/v1/issues/{key}",
      "response": "Issue",
      "permission": "work.read"
    },
    {
      "verb": "create",
      "method": "POST",
      "path": "/v1/projects/{project}/issues",
      "request": "CreateIssueRequest",
      "response": "Issue",
      "write": true,
      "permission": "work.write",
      "description": "Idempotent on the `Idempotency-Key` header or `idempotency_key`: a retry returns the original issue (200 with `Idempotent-Replayed: true`). The reporter is the token's subject; status is the project's initial status."
    },
    {
      "verb": "bulk_create",
      "method": "POST",
      "path": "/v1/projects/{project}/issues/bulk",
      "request": "BulkCreateRequest",
      "response": "IssueList",
      "write": true,
      "permission": "work.write",
      "description": "Up to 100 issues, all or none, for example a manager's list of stories from a planning meeting. Idempotent on the `Idempotency-Key` header."
    },
    {
      "verb": "update",
      "method": "PATCH",
      "path": "/v1/issues/{key}",
      "request": "UpdateIssueRequest",
      "response": "Issue",
      "write": true,
      "permission": "work.write",
      "description": "Absent fields are left alone, null clears nullable fields. Status changes go through `transition`, never through update."
    },
    {
      "verb": "transition",
      "method": "POST",
      "path": "/v1/issues/{key}/transitions",
      "request": "TransitionRequest",
      "response": "Issue",
      "write": true,
      "permission": "work.write",
      "description": "409 when the project's workflow does not allow the move."
    },
    {
      "verb": "comment",
      "method": "POST",
      "path": "/v1/issues/{key}/comments",
      "request": "AddCommentRequest",
      "response": "Comment",
      "write": true,
      "permission": "work.write"
    }
  ],
  "$defs": {
    "Issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "project",
        "type",
        "title",
        "priority",
        "status",
        "status_category",
        "reporter",
        "version",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]{1,9}-[1-9][0-9]{0,9}$"
        },
        "project": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]{1,9}$"
        },
        "type": {
          "enum": [
            "epic",
            "story",
            "task",
            "bug",
            "subtask"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 50000
        },
        "priority": {
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ]
        },
        "sla_hint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "respond_hours",
            "resolve_hours"
          ],
          "properties": {
            "respond_hours": {
              "type": "integer",
              "minimum": 1
            },
            "resolve_hours": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "status": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,29}$"
        },
        "status_category": {
          "enum": [
            "todo",
            "active",
            "done"
          ]
        },
        "reporter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 254
        },
        "assignee": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 254
        },
        "due_date": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "estimate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "parent": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9]{1,9}-[1-9][0-9]{0,9}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "sprint_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "labels": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,39}$"
          }
        },
        "rank": {
          "type": "string",
          "pattern": "^[0-9a-z]+$"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "description": "Optimistic-concurrency version; the ETag."
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "resolved_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "IssueList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/Issue"
          }
        },
        "next_cursor": {
          "type": "string"
        }
      }
    },
    "CreateIssueRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "title"
      ],
      "properties": {
        "type": {
          "enum": [
            "epic",
            "story",
            "task",
            "bug",
            "subtask"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 50000
        },
        "priority": {
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ]
        },
        "assignee": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 254
        },
        "due_date": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "estimate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 10000
        },
        "parent": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9]{1,9}-[1-9][0-9]{0,9}$"
            },
            {
              "type": "string",
              "pattern": "^\\$[0-9]{1,3}$",
              "description": "Bulk only: $N is the Nth (from 0) earlier item of the same request."
            },
            {
              "type": "null"
            }
          ]
        },
        "sprint_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "labels": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,39}$"
          }
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        }
      }
    },
    "BulkCreateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issues"
      ],
      "properties": {
        "issues": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/CreateIssueRequest"
          }
        }
      }
    },
    "UpdateIssueRequest": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 50000
        },
        "priority": {
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ]
        },
        "assignee": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 254
        },
        "due_date": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "estimate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 10000
        },
        "parent": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9]{1,9}-[1-9][0-9]{0,9}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "sprint_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "labels": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,39}$"
          }
        },
        "labels_add": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,39}$"
          }
        },
        "labels_remove": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,39}$"
          }
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "description": "Same guard as If-Match."
        }
      }
    },
    "TransitionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "to"
      ],
      "properties": {
        "to": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,29}$"
        }
      }
    },
    "AddCommentRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "body"
      ],
      "properties": {
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        }
      }
    },
    "Comment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "issue",
        "author",
        "body",
        "created_at"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "issue": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]{1,9}-[1-9][0-9]{0,9}$"
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 254
        },
        "body": {
          "type": "string",
          "maxLength": 20000
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
