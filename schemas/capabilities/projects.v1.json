{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dodwmd/companyinacan/schemas/capabilities/projects.v1.json",
  "title": "projects.v1",
  "description": "Capability `projects` (SPEC.md section 3.3): list, read and create the work tracker's projects, so other modules (time, invoices, reports) can refer to a project by key and show its name and workflow. Provided by the same service as `work`. Creation needs work.admin and an unscoped token; later configuration (workflow, SLA hints, archiving) is part of the module's own API (specs/011-work-tracker/contracts/openapi.yaml), not this contract.",
  "x-capability": "projects",
  "x-verbs": [
    {
      "verb": "list",
      "method": "GET",
      "path": "/v1/projects",
      "response": "ProjectList",
      "permission": "work.read"
    },
    {
      "verb": "get",
      "method": "GET",
      "path": "/v1/projects/{key}",
      "response": "Project",
      "permission": "work.read"
    },
    {
      "verb": "create",
      "method": "POST",
      "path": "/v1/projects",
      "request": "CreateProjectRequest",
      "response": "Project",
      "write": true,
      "permission": "work.admin",
      "description": "409 when the key exists. The default workflow is todo, in_progress, in_review, done, cancelled."
    }
  ],
  "$defs": {
    "Project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "name",
        "archived",
        "workflow",
        "created_at"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]{1,9}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "archived": {
          "type": "boolean"
        },
        "issue_count": {
          "type": "integer",
          "minimum": 0
        },
        "workflow": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "statuses",
            "initial"
          ],
          "properties": {
            "statuses": {
              "type": "array",
              "minItems": 1,
              "maxItems": 30,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "category"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,29}$"
                  },
                  "category": {
                    "enum": [
                      "todo",
                      "active",
                      "done"
                    ]
                  }
                }
              }
            },
            "initial": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,29}$"
            },
            "transitions": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,29}$"
                }
              }
            }
          }
        },
        "sla": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "respond_hours",
              "resolve_hours"
            ],
            "properties": {
              "respond_hours": {
                "type": "integer",
                "minimum": 1
              },
              "resolve_hours": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ProjectList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Project"
          }
        }
      }
    },
    "CreateProjectRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "name"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]{1,9}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "workflow": {
          "$ref": "#/$defs/Project/properties/workflow"
        },
        "sla": {
          "$ref": "#/$defs/Project/properties/sla"
        }
      }
    }
  }
}
