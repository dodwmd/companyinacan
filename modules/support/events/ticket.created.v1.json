{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dodwmd/companyinacan/schemas/events/ticket.created.v1.json",
  "title": "ticket.created.v1",
  "description": "Published by the support module's adapter when a conversation is created in the helpdesk (SPEC.md section 4.3). Delivered at least once; consumers de-duplicate on `id`. Carries no message body: consumers fetch it through the `tickets` capability if their role allows.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "time", "source", "data"],
  "properties": {
    "id": { "type": "string", "pattern": "^evt_[0-9a-f]{24}$", "description": "Unique event id, stable across redeliveries." },
    "type": { "const": "ticket.created.v1" },
    "time": { "type": "string", "format": "date-time", "description": "When the event was produced (UTC)." },
    "source": { "const": "support" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ticket_id", "mailbox", "subject", "channel", "customer", "created_at"],
      "properties": {
        "ticket_id": { "type": "string", "pattern": "^tk_[0-9]{1,18}$", "description": "Stable id in the tickets capability (the helpdesk's conversation number)." },
        "mailbox": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,40}$" },
        "subject": { "type": "string", "maxLength": 998 },
        "channel": { "enum": ["email", "web", "api"] },
        "customer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["email"],
          "properties": {
            "email": { "type": "string", "maxLength": 254 },
            "name": { "type": "string", "maxLength": 200 },
            "party_id": { "type": "string", "minLength": 1, "description": "Set once a directory party exists for this person." }
          }
        },
        "created_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
