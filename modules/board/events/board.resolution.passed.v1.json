{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dodwmd/companyinacan/schemas/events/board.resolution.passed.v1.json",
  "title": "board.resolution.passed.v1",
  "description": "Published when a resolution passes. external_type and external_ref are present when another module asked for the resolution (the seam in the resolutions capability). Delivered at least once; consumers de-duplicate on `id`. The payload carries opaque ids, dates and the result only: never names, resolution text, minutes, votes or amounts (SPEC.md sections 3.7 and 4.3).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "time",
    "source",
    "data"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^evt_[0-9a-f]{24}$",
      "description": "Unique event id, stable across redeliveries."
    },
    "type": {
      "const": "board.resolution.passed.v1"
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "description": "When the event was produced (UTC)."
    },
    "source": {
      "const": "board"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolution_id",
        "body_id",
        "result",
        "passed_on"
      ],
      "properties": {
        "resolution_id": {
          "type": "string",
          "pattern": "^res_[0-9a-f]{24}$"
        },
        "body_id": {
          "type": "string",
          "pattern": "^bdy_[0-9a-f]{24}$"
        },
        "result": {
          "const": "passed"
        },
        "passed_on": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "meeting_id": {
          "type": "string",
          "pattern": "^mtg_[0-9a-f]{24}$"
        },
        "external_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$",
          "maxLength": 64
        },
        "external_ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        }
      }
    }
  }
}
