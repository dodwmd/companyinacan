{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dodwmd/companyinacan/schemas/events/board.meeting.scheduled.v1.json",
  "title": "board.meeting.scheduled.v1",
  "description": "Published when a meeting is scheduled. Delivered at least once; consumers de-duplicate on `id`. The payload carries opaque ids, dates and the result only: never names, resolution text, minutes, votes or amounts (SPEC.md sections 3.7 and 4.3).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "time",
    "source",
    "data"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^evt_[0-9a-f]{24}$",
      "description": "Unique event id, stable across redeliveries."
    },
    "type": {
      "const": "board.meeting.scheduled.v1"
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "description": "When the event was produced (UTC)."
    },
    "source": {
      "const": "board"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "meeting_id",
        "body_id",
        "starts_on"
      ],
      "properties": {
        "meeting_id": {
          "type": "string",
          "pattern": "^mtg_[0-9a-f]{24}$"
        },
        "body_id": {
          "type": "string",
          "pattern": "^bdy_[0-9a-f]{24}$"
        },
        "starts_on": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    }
  }
}
