{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dodwmd/companyinacan/schemas/events/expense.approved.v1.json",
  "title": "expense.approved.v1",
  "description": "Published when an expense is approved. `person` is the opaque person id of the claimant. Delivered at least once; consumers de-duplicate on `id`. Carries identifiers, numbers and amounts only: no names, addresses, emails or other contact data (fetch the record through the capability if the token allows).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "time",
    "source",
    "data"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^evt_[0-9a-f]{24}$",
      "description": "Unique event id, stable across redeliveries."
    },
    "type": {
      "const": "expense.approved.v1"
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "description": "When the event was produced (UTC)."
    },
    "source": {
      "const": "finance"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expense_id",
        "person",
        "amount_minor",
        "currency",
        "category",
        "approved_at"
      ],
      "properties": {
        "expense_id": {
          "type": "integer",
          "minimum": 1
        },
        "person": {
          "type": "string",
          "maxLength": 254,
          "minLength": 1
        },
        "amount_minor": {
          "type": "integer",
          "minimum": 1
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "category": {
          "type": "string",
          "maxLength": 30,
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
