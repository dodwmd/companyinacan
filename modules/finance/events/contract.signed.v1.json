{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dodwmd/companyinacan/schemas/events/contract.signed.v1.json",
  "title": "contract.signed.v1",
  "description": "Published when a sent contract is signed and its document hash matches the text. Delivered at least once; consumers de-duplicate on `id`. Carries identifiers, numbers and amounts only: no names, addresses, emails or other contact data (fetch the record through the capability if the token allows).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "time",
    "source",
    "data"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^evt_[0-9a-f]{24}$",
      "description": "Unique event id, stable across redeliveries."
    },
    "type": {
      "const": "contract.signed.v1"
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "description": "When the event was produced (UTC)."
    },
    "source": {
      "const": "finance"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "party_id",
        "version",
        "sha256",
        "signed_at"
      ],
      "properties": {
        "contract_id": {
          "type": "integer",
          "minimum": 1
        },
        "party_id": {
          "type": "integer",
          "minimum": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "signed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
